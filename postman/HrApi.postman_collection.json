{
  "info": {
    "name": "HR API – Pruebas de calidad",
    "description": "Colección de pruebas funcionales y de contrato (estado, estructura, tiempo). Ejecutar en orden con el Collection Runner o con newman. Los nombres con [DEF-xxx] son pruebas que se espera que FALLEN porque exponen defectos documentados en docs/04-defectos.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Geografía",
      "item": [
        {
          "name": "TC-PAIS-01 Crear país válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/paises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paises"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pais-{{uniq}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"uniq\", Date.now().toString());",
                  "pm.collectionVariables.set(\"nit\", Date.now().toString().slice(-8) + \"-1\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Tiempo de respuesta < 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
                  "pm.test(\"Estructura de la respuesta\", () => { const j = pm.response.json(); [\"id\", \"nombre\"].forEach(k => pm.expect(j).to.have.property(k)); });",
                  "try { pm.collectionVariables.set(\"paisId\", pm.response.json().id); } catch (e) {}",
                  "pm.test(\"Header Location presente\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        },
